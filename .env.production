# -----------------------------------------------------------------------------
# The Ride — Production Environment
#
# Firebase project: the-ride-prod (see .firebaserc — the project's actual
# alias/ID is "the-ride-prod", not "the-ride-production"; this file's name
# matches the APP_ENV value "production", not the Firebase project ID).
# Safe to commit — every secret-shaped value below is intentionally blank;
# production's real values live in the CI secrets store only. See
# docs/deployment.md. This file is prepared for deployment, but nothing in
# this sprint deploys it (Part 9: "do not deploy, only prepare").
# -----------------------------------------------------------------------------

# --- App ---
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
EXPO_PUBLIC_APP_ENV=production
# Domain is read from this variable, never hardcoded into app source (Part 9).
APP_URL=https://the-ride.app
ADMIN_URL=https://admin.the-ride.app

# --- Build info (Sprint 4.6, Part 6-7) — injected by CI at build time from
# `git rev-parse --short HEAD` / the build timestamp. See docs/versioning.md. ---
NEXT_PUBLIC_BUILD_COMMIT=
NEXT_PUBLIC_BUILD_DATE=
EXPO_PUBLIC_BUILD_COMMIT=
EXPO_PUBLIC_BUILD_DATE=

# --- Firebase (Client SDK — safe to expose to the browser/app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-ride-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-prod.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase (Expo apps use EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=the-ride-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-prod.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Admin SDK — server-only, Cloud Functions / Next.js server) ---
FIREBASE_PROJECT_ID=the-ride-prod
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Maps & Geolocation ---
MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=

# --- Payments ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Messaging / SMS / OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Push Notifications (FCM) ---
FCM_SERVER_KEY=
EXPO_PUBLIC_FCM_SENDER_ID=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=warn

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_EMERGENCY_SOS=true
NEXT_PUBLIC_ENABLE_WALLET=true
