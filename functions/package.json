{
  "name": "@the-ride/functions",
  "version": "0.1.0",
  "private": true,
  "description": "The Ride — Firebase Cloud Functions, organized by domain (auth, payments, trips, notifications, etc).",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@the-ride/types": "workspace:*",
    "@the-ride/utils": "workspace:*",
    "firebase-admin": "^12.5.0",
    "firebase-functions": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@the-ride/config": "workspace:*",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "firebase-functions-test": "^3.3.0"
  }
}
