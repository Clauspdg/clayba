# Cloud Functions runtime environment variables (loaded via dotenv / Firebase params).
# See the root .env.example for the full shared list.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
FCM_SERVER_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# --- Payments (docs/payments.md) ---
# Copy to functions/.env.<firebase-project-id> (e.g. .env.the-ride-dev).
# PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET are NOT set here — they are
# Secret Manager secrets: `firebase functions:secrets:set PAYPAL_CLIENT_ID`.
PAYPAL_ENV=sandbox
WEB_APP_URL=https://the-ride-web-dev.web.app
