# See the root .env.example for the full list of shared variables.
# Expo apps must prefix client-exposed variables with EXPO_PUBLIC_.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Android Google Maps SDK key — required for the Home/Ride Request/Active
# Ride map to render live tiles (react-native-maps always uses the native
# Google Maps SDK on Android, regardless of provider prop). Create one in
# Google Cloud Console with "Maps SDK for Android" enabled, restricted to
# package name com.theride.driver + the release keystore's SHA-1. Without
# a real key here, the map area renders Google's blank/"for development
# purposes only" placeholder instead of real tiles — everything else
# (marker, overlay, bottom sheet) still works.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
