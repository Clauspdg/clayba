{
  "expo": {
    "name": "CLAYBA Driver",
    "slug": "the-ride-driver",
    "scheme": "theridedriver",
    "version": "0.1.8",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1A2D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.theride.driver"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1A2D"
      },
      "package": "com.theride.driver",
      "versionCode": 19
    },
    "owner": "clauspp",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CLAYBA Driver uses your location to receive nearby ride requests and provide live trip tracking."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B1A2D"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "42d0f777-f6a9-4ec5-835e-7d86e9554344"
      }
    }
  }
}
