# -----------------------------------------------------------------------------
# The Ride — Root Environment Variables (example)
# Copy this file to `.env` at the root, and to each app's own `.env` as needed.
# Never commit real secrets. Use a secrets manager (GCP Secret Manager / Vercel
# Environment Variables) for staging and production.
# -----------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Build info (Sprint 4.6, Part 6-7) — see .env.development/.staging/.production
# and docs/versioning.md. Populated by the build pipeline, not by hand. ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_BUILD_COMMIT=
NEXT_PUBLIC_BUILD_DATE=
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_BUILD_COMMIT=
EXPO_PUBLIC_BUILD_DATE=

# --- Firebase (Client SDK — safe to expose to the browser/app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase (Expo apps use EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Admin SDK — server-only, Cloud Functions / Next.js server) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Maps & Geolocation ---
# MAP_PROVIDER selects which client @the-ride/api's createMapProvider() builds — "google" or "mapbox". See docs/maps.md.
MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=

# --- Payments ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Messaging / SMS / OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Push Notifications (FCM) ---
FCM_SERVER_KEY=
EXPO_PUBLIC_FCM_SENDER_ID=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_EMERGENCY_SOS=true
NEXT_PUBLIC_ENABLE_WALLET=true
