# -----------------------------------------------------------------------------
# The Ride — Development Environment
#
# Firebase project: the-ride-dev (see .firebaserc) — this IS the team's real
# shared dev project (Sprint 5). The values below (apiKey, authDomain,
# projectId, storageBucket, messagingSenderId) are Firebase's public client
# config, safe to commit — Google does not treat these as secrets; access
# control lives in firestore.rules/storage.rules, not in the API key. Each
# app additionally has its own gitignored .env.local (apps/*/.env.local)
# carrying its exact per-app appId/measurementId — see docs/deployment.md.
#
# Never put FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY (the real Admin SDK
# secret) in this file — those go in the gitignored .env.development.local
# only. This file's copies are intentionally left blank below.
# -----------------------------------------------------------------------------

# --- App ---
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Build info (Sprint 4.6, Part 6-7) — left blank locally; the CI build
# pipeline injects these from `git rev-parse --short HEAD` / the build
# timestamp. See docs/versioning.md. ---
NEXT_PUBLIC_BUILD_COMMIT=
NEXT_PUBLIC_BUILD_DATE=
EXPO_PUBLIC_BUILD_COMMIT=
EXPO_PUBLIC_BUILD_DATE=

# --- Firebase (Client SDK — safe to expose to the browser/app) ---
# Shared across both web apps registered in the-ride-dev ("THE RIDE WEBSITE",
# "THE RIDE ADMIN") — apiKey/authDomain/projectId/storageBucket/senderId are
# identical per Firebase project; only appId/measurementId differ per
# registered app, which is why each app's own .env.local sets those instead
# of this shared root file. See docs/deployment.md.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyB7JqGkOR5EQptl8WHEEAfDTVUecb9-I_Y
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-ride-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1054412663514
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase (Expo apps use EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCw8QhQC3PK5SDz8oaBhwXs732WW_fmJBo
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=the-ride-dev
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-dev.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1054412663514
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Admin SDK — server-only, Cloud Functions / Next.js server) ---
# Real secret — set in the gitignored .env.development.local, never here.
FIREBASE_PROJECT_ID=the-ride-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Maps & Geolocation ---
MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=

# --- Payments ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Messaging / SMS / OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Push Notifications (FCM) ---
FCM_SERVER_KEY=
EXPO_PUBLIC_FCM_SENDER_ID=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=debug

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_EMERGENCY_SOS=true
NEXT_PUBLIC_ENABLE_WALLET=true
