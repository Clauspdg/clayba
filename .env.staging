# -----------------------------------------------------------------------------
# The Ride — Staging Environment
#
# Firebase project: the-ride-staging (see .firebaserc). Safe to commit —
# every secret-shaped value below is intentionally blank; staging's real
# values live in the CI secrets store (see docs/deployment.md), never here.
# Loaded explicitly by `pnpm staging` (scripts/deploy-hosting.mjs) — Next.js
# does not auto-load a file named `.env.staging` the way it does
# `.env.production`, so builds must go through that script, not `next build`
# directly. See docs/versioning.md.
# -----------------------------------------------------------------------------

# --- App ---
NODE_ENV=production
APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_APP_ENV=staging
# Domain is read from this variable, never hardcoded into app source (Part 8).
APP_URL=https://staging.the-ride.app
ADMIN_URL=https://admin-staging.the-ride.app

# --- Build info (Sprint 4.6, Part 6-7) — injected by CI at build time from
# `git rev-parse --short HEAD` / the build timestamp. See docs/versioning.md. ---
NEXT_PUBLIC_BUILD_COMMIT=
NEXT_PUBLIC_BUILD_DATE=
EXPO_PUBLIC_BUILD_COMMIT=
EXPO_PUBLIC_BUILD_DATE=

# --- Firebase (Client SDK — safe to expose to the browser/app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-staging.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=the-ride-staging
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-staging.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase (Expo apps use EXPO_PUBLIC_ prefix) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=the-ride-staging.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=the-ride-staging
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=the-ride-staging.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (Admin SDK — server-only, Cloud Functions / Next.js server) ---
FIREBASE_PROJECT_ID=the-ride-staging
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Maps & Geolocation ---
MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_SERVER_ACCESS_TOKEN=

# --- Payments ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Messaging / SMS / OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Push Notifications (FCM) ---
FCM_SERVER_KEY=
EXPO_PUBLIC_FCM_SENDER_ID=

# --- Observability ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# --- Feature Flags ---
NEXT_PUBLIC_ENABLE_EMERGENCY_SOS=true
NEXT_PUBLIC_ENABLE_WALLET=true
