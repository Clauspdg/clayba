# Dependencies
node_modules/
.pnpm-store/

# Turborepo
.turbo/

# Next.js
.next/
out/

# Expo / React Native
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Release artifacts — the release-notes.md/version.json/known-issues.md/
# checksums.txt manifest files under release/*/ are small and worth
# tracking in git history; the real .apk/.aab binaries (tens of MB each)
# are not — they belong in Play Store / GitHub Releases / artifact
# storage, not the git repo itself.
release/**/*.apk
release/**/*.aab

# Build outputs
build/
# Cloud Functions' tsc output only — NOT a blanket match, which previously
# (and silently) excluded every app's real apps/*/src/lib/ source folder
# from git entirely (Sprint 5 bug: EAS builds only see git-tracked files,
# so this made every app's firebase-client.ts invisible to real builds).
/functions/lib/
*.tsbuildinfo

# Testing / coverage
coverage/

# Environment variables
.env
.env.local
.env.*.local
!.env.example

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
ui-debug.log
*-service-account*.json
serviceAccountKey.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.idea/
*.iml
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Misc
*.pem
*.tgz
.eslintcache

# Malformed Claude/ADC scratchpad credential files that can leak into the
# repo root instead of the OS temp dir (contain OAuth client_secret/refresh_token)
/*adc-temp*.json
/application_default_credentials.json
