
# Metro (React Native/Expo's bundler) cannot walk pnpm's isolated, symlinked
# node_modules tree the way Node's own resolver does, so transitive runtime
# deps pulled in by expo/expo-router/@expo/metro-runtime (babel-preset-expo,
# @babel/runtime, whatwg-fetch, etc.) fail to resolve during `expo start`.
# Hoisting gives Metro a flat node_modules it can actually resolve against.
node-linker=hoisted
